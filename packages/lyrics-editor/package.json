{
  "name": "@audoria/lyrics-editor",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A lyrics timing editor: tap words in time with the song, nudge, split and merge them, set readings",
  "sideEffects": [
    "*.vue",
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@audoria/lyrics-core": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  }
}
